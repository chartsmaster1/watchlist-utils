<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Unique name for this scheduled job. -->
  <key>Label</key>
  <string>com.watchlist-utils.refresh</string>

  <!-- What to run. Wrapper cd's to the repo and calls refresh_and_deploy.sh. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/tamilla/Desktop/watchlist-utils/scheduled_refresh.sh</string>
  </array>

  <!-- Run weekdays (Mon-Fri) at 05:30 local time. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>30</integer>
      <key>Weekday</key>
      <integer>1</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>30</integer>
      <key>Weekday</key>
      <integer>2</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>30</integer>
      <key>Weekday</key>
      <integer>3</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>30</integer>
      <key>Weekday</key>
      <integer>4</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>5</integer>
      <key>Minute</key>
      <integer>30</integer>
      <key>Weekday</key>
      <integer>5</integer>
    </dict>
  </array>

  <!-- Run from the repo so relative paths (public/src/main.py, public/data) resolve. -->
  <key>WorkingDirectory</key>
  <string>/Users/tamilla/Desktop/watchlist-utils</string>

  <!-- Append stdout/stderr here as well as logs/scheduled-refresh.log. -->
  <key>StandardOutPath</key>
  <string>/Users/tamilla/Desktop/watchlist-utils/logs/launchd-refresh.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tamilla/Desktop/watchlist-utils/logs/launchd-refresh.err.log</string>

  <!-- Don't run two refreshes at once if one runs long. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
