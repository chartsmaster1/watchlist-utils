<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Unique name for this scheduled job. -->
  <key>Label</key>
  <string>com.watchlist-utils.refresh</string>

  <!-- What to run. Wrapper cd's to the repo and calls refresh_and_deploy.sh. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/tamilla/watchlist-utils/scheduled_refresh.sh</string>
  </array>

  <!-- Monthly target: 1st of each month at 05:30 local time.
       Catch-up below covers a missed occurrence (Mac asleep/off). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <!-- Catch-up triggers: the wrapper runs the refresh only when the latest
       monthly occurrence has passed without a recorded success. -->
  <!-- Every login / reboot. -->
  <key>RunAtLoad</key>
  <true/>
  <!-- Hourly check: catches a miss while the Mac is awake but was asleep
       at 05:30 (launchd has no built-in "run if missed"). No-op unless due. -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <!-- Run from the repo so relative paths (public/src/main.py, public/data) resolve. -->
  <key>WorkingDirectory</key>
  <string>/Users/tamilla/watchlist-utils</string>

  <!-- Append stdout/stderr here as well as logs/scheduled-refresh.log. -->
  <key>StandardOutPath</key>
  <string>/Users/tamilla/watchlist-utils/logs/launchd-refresh.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tamilla/watchlist-utils/logs/launchd-refresh.err.log</string>

  <!-- Don't run two refreshes at once if one runs long. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
